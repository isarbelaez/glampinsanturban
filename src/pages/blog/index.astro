---
import { Badge } from '@/components/ui/badge';
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title="Blog" description="Todos los artículos y posts de glampinglean">
  <main class="mx-auto max-w-4xl px-4 py-16">
    <h1 class="mb-8 text-4xl font-bold tracking-tight">Blog</h1>

    {sortedPosts.length === 0 && <p class="text-gray-500">No hay posts publicados aún.</p>}

    <ul class="space-y-8">
      {
        sortedPosts.map((post) => (
          <li class="border-b border-gray-200 pb-8 dark:border-gray-800">
            <a href={`/blog/${post.id}/`} class="group block">
              <time
                datetime={post.data.pubDate.toISOString()}
                class="text-sm text-gray-500 dark:text-gray-400"
              >
                {post.data.pubDate.toLocaleDateString('es-ES', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </time>
              <h2 class="mt-1 text-2xl font-semibold group-hover:text-blue-600 dark:group-hover:text-blue-400">
                {post.data.title}
              </h2>
              <p class="mt-2 text-gray-600 dark:text-gray-400">{post.data.description}</p>
              {post.data.tags.length > 0 && (
                <div class="mt-3 flex flex-wrap gap-2">
                  {post.data.tags.map((tag) => (
                    <Badge>#{tag}</Badge>
                  ))}
                </div>
              )}
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</Layout>
