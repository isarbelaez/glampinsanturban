---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Services from '../components/Services.astro';
import Testimonials from '../components/Testimonials.astro';
import FeaturedPlans from '../components/FeaturedPlans.astro';
import { CinematicExperiences } from '../components/section/CinematicExperiences';
---

<Layout title="Experiencias">
  <Navbar />
  <main>
    {/* Sección interactiva y narrativa principal */}
    <CinematicExperiences client:load />

    {/* Carrusel de planes disponibles */}
    <FeaturedPlans />

    {/* Servicios */}
    <Services />

    {/* Testimonios */}
    <Testimonials />
  </main>
  <Footer />
</Layout>
