---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import HowToGetThere from '../components/section/HowToGetThere.astro';
import Services from '../components/Services.astro';
import Testimonials from '../components/Testimonials.astro';
import BookingIsland from '../components/booking/BookingIsland.astro';
---

<Layout title="Reservar | Santurban Glamping">
  <Navbar />
  <main>
    {/* 1. Formulario de Reserva */}
    <BookingIsland server:defer>
      <div slot="fallback" class="bg-background relative py-40">
        <div class="container mx-auto px-4 text-center">
          <div
            class="bg-primary/20 mx-auto h-12 w-12 animate-spin rounded-full border-4 border-t-transparent"
          >
          </div>
          <p class="text-foreground/60 mt-4 font-serif text-lg">Cargando disponibilidad...</p>
        </div>
      </div>
    </BookingIsland>

    {/* 2. Cómo llegar */}
    <HowToGetThere />

    {/* 3. Servicios */}
    <Services />

    {/* 4. Testimonios */}
    <Testimonials />
  </main>
  <Footer />
</Layout>
