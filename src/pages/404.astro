---
import { Button } from '@/components/ui/button';
import Layout from '@/layouts/Layout.astro';
---

<Layout title="Página no encontrada" description="Esta página no existe.">
  <main class="flex min-h-screen flex-col items-center justify-center px-4 text-center">
    <h1 class="text-muted text-8xl font-bold">404</h1>
    <h2 class="text-foreground mt-4 text-2xl font-semibold">Página no encontrada</h2>
    <p class="text-muted-foreground mt-2">La página que buscas no existe o fue movida.</p>
    <a href={import.meta.env.BASE_URL}>
      <Button> Volver al inicio </Button>
    </a>
  </main>
</Layout>
