---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import Services from '../../components/Services.astro';
import Testimonials from '../../components/Testimonials.astro';
import FeaturedPlans from '../../components/FeaturedPlans.astro';
import PlanDetails from '../../components/section/PlanDetails.astro';
import { plansData } from '../../data/plans';

export async function getStaticPaths() {
  return plansData.map((plan) => ({
    params: { slug: plan.slug },
    props: { plan },
  }));
}

const { plan } = Astro.props;
---

<Layout title={`${plan.title} | Santurban Glamping`}>
  <Navbar />
  <main>
    {/* 1. Detalles del plan */}
    <PlanDetails plan={plan} />

    {/* 2. Carrusel con los demás planes (excluyendo el actual) */}
    <FeaturedPlans excludeSlug={plan.slug} />

    {/* 3. Servicios */}
    <Services />

    {/* 4. Testimonios */}
    <Testimonials />
  </main>
  <Footer />
</Layout>
