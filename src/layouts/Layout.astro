---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
}

const {
  title = 'Glamping Santurban',
  description = 'Escapa a la naturaleza con lujo y estilo. El glamping más exclusivo para desconectar y vivir experiencias inolvidables.',
  image = '/og-image.png',
  canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://terralunaglamping.com'),
} = Astro.props;

const siteTitle = title === 'Glamping Santurban' ? title : `${title} | Glamping Santurban `;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Favicon -->
    <link rel="icon" type="image/webp" href="/images/logo.webp" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,700;1,8..60,400&family=Bebas+Neue&display=swap"
      rel="stylesheet"
    />

    <!-- SEO -->
    <title>{siteTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta
      property="og:image"
      content={new URL(image, Astro.site || 'https://terralunaglamping.com')}
    />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={description} />
    <meta
      name="twitter:image"
      content={new URL(image, Astro.site || 'https://terralunaglamping.com')}
    />
  </head>
  <body class="bg-background text-foreground selection:bg-primary antialiased selection:text-white">
    <slot />
  </body>
</html>
