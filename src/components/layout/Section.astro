---
import { cn } from '@/lib/utils';

interface Props {
  id?: string;
  className?: string;
}

const { id, className } = Astro.props;
---

<section id={id} class={cn('border-t border-white/5 bg-[#050f0e] py-24', className)}>
  <div class="container mx-auto px-4 md:px-6">
    <div class="mb-16 text-center">
      <slot />
    </div>
  </div>
</section>
