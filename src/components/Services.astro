---
import pkg from 'lucide-react';
const { Utensils, Wifi, Coffee, Music, Zap } = pkg;

const services = [
  { icon: Utensils, title: 'Gastronomía', desc: 'Platos locales preparados.' },
  { icon: Wifi, title: 'Conectividad', desc: 'Wi-Fi de alta velocidad.' },
  { icon: Coffee, title: 'Desayuno', desc: 'Desayuno artesanal.' },
  { icon: Music, title: 'Fogatas', desc: 'Noches mágicas.' },
  {
    icon: Zap,
    title: 'Malla Catamarán',
    desc: 'Relajación en las alturas.',
  },
  {
    isSheep: true,
    title: 'Animalitos',
    desc: 'Alimenta nuestros animales.',
  },
];
---

<section id="servicios" class="bg-background border-t border-black/5 py-24">
  <div class="container mx-auto px-4 md:px-6">
    <div class="mb-16 text-center">
      <p class="text-primary mb-4 text-[10px] font-bold tracking-[0.4em] uppercase">
        Lo que ofrecemos
      </p>
      <h2
        class="text-foreground font-serif text-3xl font-bold tracking-[0.15em] uppercase md:text-5xl"
      >
        Nuestros Servicios
      </h2>
    </div>

    <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6">
      {
        services.map((service) => (
          <div class="group flex flex-col items-center text-center">
            <div class="group-hover:bg-primary group-hover:border-primary bg-card text-primary mb-4 flex h-14 w-14 items-center justify-center overflow-hidden rounded-xl border border-black/10 transition-all duration-500 group-hover:scale-110 group-hover:text-white">
              {service.isSheep ? (
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="h-7 w-7"
                >
                  {/* Lana de la cabeza */}
                  <path d="M8 9a4 4 0 0 1 8 0" />
                  <path d="M16 9a2 2 0 0 1 2 2v1a2 2 0 0 1-2 2" />
                  <path d="M8 9a2 2 0 0 0-2 2v1a2 2 0 0 0 2 2" />
                  {/* Cara (hocico) */}
                  <path d="M8 14v1a4 4 0 0 0 8 0v-1" />
                  {/* Ojos */}
                  <path d="M10.5 13.5h.01" stroke-width="2" />
                  <path d="M13.5 13.5h.01" stroke-width="2" />
                  {/* Nariz/Boca */}
                  <path d="M12 15v1" />
                  <path d="M11 17h2" />
                  {/* Orejas */}
                  <path d="M6 11l-2 1.5 2-1" />
                  <path d="M18 11l2 1.5-2-1" />
                </svg>
              ) : (
                <service.icon size={24} strokeWidth={1.5} />
              )}
            </div>
            <h3 class="text-foreground mb-1 text-[10px] font-bold tracking-widest uppercase">
              {service.title}
            </h3>
            <p class="text-foreground/40 max-w-[120px] text-[9px] leading-relaxed">
              {service.desc}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
