---
import pkg from 'lucide-react';
const { Star, Utensils, Wifi, Coffee, Music, Zap } = pkg;

const services = [
  { icon: Utensils, title: 'Gastronomía', desc: 'Platos locales preparados por chefs expertos.' },
  { icon: Wifi, title: 'Conectividad', desc: 'Wi-Fi de alta velocidad en todas nuestras cabañas.' },
  { icon: Coffee, title: 'Desayuno', desc: 'Desayuno artesanal servido en tu terraza.' },
  { icon: Music, title: 'Fogatas', desc: 'Noches mágicas con música y malvaviscos.' },
  {
    icon: Zap,
    title: 'Malla Catamarán',
    desc: 'Disfruta de la experiencia de relajarte en las alturas.',
  },
];
---

<section id="servicios" class="bg-background border-t border-black/5 py-24">
  <div class="container mx-auto px-4 md:px-6">
    <div class="mb-16 text-center">
      <p class="text-primary mb-4 text-[10px] font-bold tracking-[0.4em] uppercase">
        Lo que ofrecemos
      </p>
      <h2
        class="text-foreground font-serif text-3xl font-bold tracking-[0.15em] uppercase md:text-5xl"
      >
        Nuestros Servicios
      </h2>
    </div>

    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-5">
      {
        services.map((service) => (
          <div class="group flex flex-col items-center text-center">
            <div class="group-hover:bg-primary group-hover:border-primary bg-card text-primary mb-6 flex h-16 w-16 items-center justify-center rounded-2xl border border-black/10 transition-all duration-500 group-hover:scale-110 group-hover:text-white">
              <service.icon size={28} strokeWidth={1.5} />
            </div>
            <h3 class="text-foreground mb-2 text-sm font-bold tracking-widest uppercase">
              {service.title}
            </h3>
            <p class="text-foreground/40 text-xs leading-relaxed">{service.desc}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
