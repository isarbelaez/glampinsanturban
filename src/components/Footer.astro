---
import Logo from './Logo.astro';
import pkg from 'lucide-react';
const { Send } = pkg;

const socialLinks = [
  {
    name: 'Facebook',
    href: 'https://www.facebook.com/profile.php?id=100063774896366',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-[18px] h-[18px]"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>`,
  },
  {
    name: 'Instagram',
    href: 'https://www.instagram.com/glampingsanturban/',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-[18px] h-[18px]"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>`,
  },
];
---

<footer class="bg-secondary relative overflow-hidden border-t border-white/5 pt-24 pb-12">
  <div class="container mx-auto px-4 md:px-6">
    <div class="mb-16 grid grid-cols-1 gap-12 md:grid-cols-2 lg:grid-cols-4">
      <!-- Branding & Description -->
      <div class="lg:col-span-1">
        <Logo size="text-3xl" className="mb-6 text-white" asLink={false} />
        <p class="mb-8 text-sm leading-relaxed text-white/50">
          Experiencias de lujo en contacto con la naturaleza. Descubre el glamping más exclusivo de
          la región y escapa a un mundo de estilo y relajación.
        </p>
        <div class="flex gap-4">
          {
            socialLinks.map((social) => (
              <a
                href={social.href}
                class="hover:bg-primary flex h-10 w-10 items-center justify-center rounded-full bg-white/5 text-white/60 transition-all duration-300 hover:text-white"
                aria-label={social.name}
                set:html={social.icon}
              />
            ))
          }
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="mb-8 text-xs font-bold tracking-widest text-white uppercase">Explorar</h4>
        <ul class="space-y-4">
          <li>
            <a
              href={`${import.meta.env.BASE_URL}#como-llegar`}
              class="hover:text-primary text-sm text-white/50 transition-colors">Cómo llegar</a
            >
          </li>
          <li>
            <a
              href={`${import.meta.env.BASE_URL}experiencias/`}
              class="hover:text-primary text-sm text-white/50 transition-colors">Experiencias</a
            >
          </li>
        </ul>
      </div>

      <!-- Accommodations -->
      <div>
        <h4 class="mb-8 text-xs font-bold tracking-widest text-white uppercase">
          Planes y paquetes
        </h4>
        <ul class="space-y-4">
          <li>
            <a
              href={`${import.meta.env.BASE_URL}planes/santurban/`}
              class="hover:text-primary text-sm text-white/50 transition-colors">Santurbán</a
            >
          </li>
          <li>
            <a
              href={`${import.meta.env.BASE_URL}planes/plan-romantico/`}
              class="hover:text-primary text-sm text-white/50 transition-colors">Plan Romantico</a
            >
          </li>
          <li>
            <a
              href={`${import.meta.env.BASE_URL}planes/plan-laguna-encantada/`}
              class="hover:text-primary text-sm text-white/50 transition-colors"
              >Plan Laguna Encantada</a
            >
          </li>
          <li>
            <a
              href={`${import.meta.env.BASE_URL}planes/plan-paramos/`}
              class="hover:text-primary text-sm text-white/50 transition-colors">Plan Paramos</a
            >
          </li>
          <li>
            <a
              href={`${import.meta.env.BASE_URL}planes/plan-noche-de-pareja/`}
              class="hover:text-primary text-sm text-white/50 transition-colors">Noche de parejas</a
            >
          </li>
        </ul>
      </div>

      <!-- Newsletter -->
      <div>
        <h4 class="mb-8 text-xs font-bold tracking-widest text-white uppercase">Únete al Club</h4>
        <p class="mb-6 text-sm text-white/50">
          Recibe ofertas exclusivas y guías de viaje directamente en tu correo.
        </p>
        <form id="newsletter-form" class="relative">
          <input
            type="email"
            id="newsletter-email"
            name="email"
            required
            placeholder="Tu email..."
            class="focus:border-primary w-full rounded-lg border border-white/10 bg-white/5 px-4 py-3 text-sm text-white transition-all focus:outline-none"
          />
          <button
            type="submit"
            class="text-primary absolute top-1/2 right-2 -translate-y-1/2 transition-colors hover:text-white"
          >
            <Send size={20} />
          </button>
        </form>
        <p id="newsletter-msg" class="text-primary mt-4 hidden text-sm font-bold">
          ¡Te uniste al club para más información!
        </p>
      </div>
    </div>

    <div
      class="flex flex-col items-center justify-between gap-6 border-t border-black/5 pt-12 md:flex-row"
    >
      <p class="text-[10px] font-bold tracking-widest text-white/30 uppercase">
        © Hecho por <a
          href=""
          target="_blank"
          rel="noopener noreferrer"
          class="transition-colors hover:text-white">Isabella Arbelaez</a
        >
      </p>
    </div>
  </div>
</footer>

<script>
  const form = document.getElementById('newsletter-form') as HTMLFormElement;
  const msg = document.getElementById('newsletter-msg');

  if (form && msg) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const emailInput = document.getElementById('newsletter-email') as HTMLInputElement;
      const email = emailInput.value;

      try {
        // NOTA PARA EL USUARIO:
        // Debes reemplazar esta URL con la tuya generada en Apps Script
        const GOOGLE_SCRIPT_URL =
          'https://script.google.com/macros/s/AKfycbxdhSg7euHtIAXJkp2PQ64KhfLaObUZMTAn8SMEtpzFiprnbVUrczLJcTH6SCulik3B/exec';

        // Se usa form-urlencoded para no tener problemas de CORS con Apps Script
        const formData = new URLSearchParams();
        formData.append('email', email);

        if (!GOOGLE_SCRIPT_URL.includes('TU_ID_AQUI')) {
          fetch(GOOGLE_SCRIPT_URL, {
            method: 'POST',
            mode: 'no-cors',
            headers: {
              'Content-Type': 'application/x-www-form-urlencoded',
            },
            body: formData.toString(),
          }).catch((err) => console.error(err));
        }

        // Mostrar mensaje de éxito
        form.reset();
        msg.classList.remove('hidden');

        // Ocultar mensaje después de 5 segundos
        setTimeout(() => {
          msg.classList.add('hidden');
        }, 5000);
      } catch (error) {
        console.error('Error al suscribirse:', error);
      }
    });
  }
</script>
