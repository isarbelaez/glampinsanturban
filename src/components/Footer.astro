---
import pkg from "lucide-react";
const { Send } = pkg;

const socialLinks = [
  { 
    name: "Facebook", 
    href: "#", 
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-[18px] h-[18px]"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>`
  },
  { 
    name: "Instagram", 
    href: "#", 
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-[18px] h-[18px]"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>`
  },
  { 
    name: "Twitter", 
    href: "#", 
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-[18px] h-[18px]"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"/></svg>`
  },
];
---

<footer class="bg-[#040d0c] pt-24 pb-12 border-t border-white/5 relative overflow-hidden">
  <div class="container mx-auto px-4 md:px-6">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-16">
      <!-- Branding & Description -->
      <div class="lg:col-span-1">
        <div class="text-white font-serif text-3xl font-bold tracking-tighter flex items-center mb-6">
          TERRA<span class="text-primary italic">LUNA</span>
        </div>
        <p class="text-white/50 text-sm leading-relaxed mb-8">
          Experiencias de lujo en contacto con la naturaleza. Descubre el glamping más exclusivo de la región y escapa a un mundo de estilo y relajación.
        </p>
        <div class="flex gap-4">
          {socialLinks.map((social) => (
            <a 
              href={social.href} 
              class="w-10 h-10 rounded-full bg-white/5 flex items-center justify-center text-white/60 hover:bg-primary hover:text-white transition-all duration-300"
              aria-label={social.name}
              set:html={social.icon}
            />
          ))}
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="text-white font-bold uppercase tracking-widest text-xs mb-8">Destinos</h4>
        <ul class="space-y-4">
          <li><a href="#" class="text-white/50 hover:text-primary text-sm transition-colors">Cali, Valle</a></li>
          <li><a href="#" class="text-white/50 hover:text-primary text-sm transition-colors">Salento, Quindío</a></li>
          <li><a href="#" class="text-white/50 hover:text-primary text-sm transition-colors">Guatapé, Antioquia</a></li>
          <li><a href="#" class="text-white/50 hover:text-primary text-sm transition-colors">Villa de Leyva</a></li>
        </ul>
      </div>

      <!-- Accommodations -->
      <div>
        <h4 class="text-white font-bold uppercase tracking-widest text-xs mb-8">Alojamiento</h4>
        <ul class="space-y-4">
          <li><a href="#" class="text-white/50 hover:text-primary text-sm transition-colors">Domo Luna Premium</a></li>
          <li><a href="#" class="text-white/50 hover:text-primary text-sm transition-colors">Cabaña del Bosque</a></li>
          <li><a href="#" class="text-white/50 hover:text-primary text-sm transition-colors">Safari Luxury Tent</a></li>
          <li><a href="#" class="text-white/50 hover:text-primary text-sm transition-colors">Eco-Pod Deluxe</a></li>
        </ul>
      </div>

      <!-- Newsletter -->
      <div>
        <h4 class="text-white font-bold uppercase tracking-widest text-xs mb-8">Únete al Club</h4>
        <p class="text-white/50 text-sm mb-6">Recibe ofertas exclusivas y guías de viaje directamente en tu correo.</p>
        <div class="relative">
          <input 
            type="email" 
            placeholder="Tu email..." 
            class="w-full bg-white/5 border border-white/10 rounded-lg px-4 py-3 text-white text-sm focus:outline-none focus:border-primary transition-all"
          />
          <button class="absolute right-2 top-1/2 -translate-y-1/2 text-primary hover:text-white transition-colors">
            <Send size={20} />
          </button>
        </div>
      </div>
    </div>

    <div class="pt-12 border-t border-white/5 flex flex-col md:flex-row justify-between items-center gap-6">
      <p class="text-white/30 text-[10px] uppercase tracking-widest font-bold">
        © 2026 TERRA LUNA GLAMPING. Todos los derechos reservados.
      </p>
      <div class="flex gap-8">
        <a href="#" class="text-white/30 hover:text-white text-[10px] uppercase tracking-widest font-bold transition-colors">Privacidad</a>
        <a href="#" class="text-white/30 hover:text-white text-[10px] uppercase tracking-widest font-bold transition-colors">Términos</a>
        <a href="#" class="text-white/30 hover:text-white text-[10px] uppercase tracking-widest font-bold transition-colors">Cookies</a>
      </div>
    </div>
  </div>
</footer>
