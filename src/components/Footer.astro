---
import Logo from './Logo.astro';
import pkg from 'lucide-react';
const { Send } = pkg;

const socialLinks = [
  {
    name: 'Facebook',
    href: '#',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-[18px] h-[18px]"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>`,
  },
  {
    name: 'Instagram',
    href: '#',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-[18px] h-[18px]"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>`,
  },
  {
    name: 'Twitter',
    href: '#',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-[18px] h-[18px]"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"/></svg>`,
  },
];
---

<footer class="relative overflow-hidden border-t border-white/5 bg-[#040d0c] pt-24 pb-12">
  <div class="container mx-auto px-4 md:px-6">
    <div class="mb-16 grid grid-cols-1 gap-12 md:grid-cols-2 lg:grid-cols-4">
      <!-- Branding & Description -->
      <div class="lg:col-span-1">
        <Logo size="text-3xl" className="mb-6" asLink={false} />
        <p class="mb-8 text-sm leading-relaxed text-white/50">
          Experiencias de lujo en contacto con la naturaleza. Descubre el glamping más exclusivo de
          la región y escapa a un mundo de estilo y relajación.
        </p>
        <div class="flex gap-4">
          {
            socialLinks.map((social) => (
              <a
                href={social.href}
                class="hover:bg-primary flex h-10 w-10 items-center justify-center rounded-full bg-white/5 text-white/60 transition-all duration-300 hover:text-white"
                aria-label={social.name}
                set:html={social.icon}
              />
            ))
          }
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="mb-8 text-xs font-bold tracking-widest text-white uppercase">Destinos</h4>
        <ul class="space-y-4">
          <li>
            <a href="#" class="hover:text-primary text-sm text-white/50 transition-colors"
              >Cali, Valle</a
            >
          </li>
          <li>
            <a href="#" class="hover:text-primary text-sm text-white/50 transition-colors"
              >Salento, Quindío</a
            >
          </li>
          <li>
            <a href="#" class="hover:text-primary text-sm text-white/50 transition-colors"
              >Guatapé, Antioquia</a
            >
          </li>
          <li>
            <a href="#" class="hover:text-primary text-sm text-white/50 transition-colors"
              >Villa de Leyva</a
            >
          </li>
        </ul>
      </div>

      <!-- Accommodations -->
      <div>
        <h4 class="mb-8 text-xs font-bold tracking-widest text-white uppercase">Alojamiento</h4>
        <ul class="space-y-4">
          <li>
            <a href="#" class="hover:text-primary text-sm text-white/50 transition-colors"
              >Domo Luna Premium</a
            >
          </li>
          <li>
            <a href="#" class="hover:text-primary text-sm text-white/50 transition-colors"
              >Cabaña del Bosque</a
            >
          </li>
          <li>
            <a href="#" class="hover:text-primary text-sm text-white/50 transition-colors"
              >Safari Luxury Tent</a
            >
          </li>
          <li>
            <a href="#" class="hover:text-primary text-sm text-white/50 transition-colors"
              >Eco-Pod Deluxe</a
            >
          </li>
        </ul>
      </div>

      <!-- Newsletter -->
      <div>
        <h4 class="mb-8 text-xs font-bold tracking-widest text-white uppercase">Únete al Club</h4>
        <p class="mb-6 text-sm text-white/50">
          Recibe ofertas exclusivas y guías de viaje directamente en tu correo.
        </p>
        <div class="relative">
          <input
            type="email"
            placeholder="Tu email..."
            class="focus:border-primary w-full rounded-lg border border-white/10 bg-white/5 px-4 py-3 text-sm text-white transition-all focus:outline-none"
          />
          <button
            class="text-primary absolute top-1/2 right-2 -translate-y-1/2 transition-colors hover:text-white"
          >
            <Send size={20} />
          </button>
        </div>
      </div>
    </div>

    <div
      class="flex flex-col items-center justify-between gap-6 border-t border-white/5 pt-12 md:flex-row"
    >
      <p class="text-[10px] font-bold tracking-widest text-white/30 uppercase">
        © 2026 GLAMPIN SANTURBAN. Todos los derechos reservados.
      </p>
      <div class="flex gap-8">
        <a
          href="#"
          class="text-[10px] font-bold tracking-widest text-white/30 uppercase transition-colors hover:text-white"
          >Privacidad</a
        >
        <a
          href="#"
          class="text-[10px] font-bold tracking-widest text-white/30 uppercase transition-colors hover:text-white"
          >Términos</a
        >
        <a
          href="#"
          class="text-[10px] font-bold tracking-widest text-white/30 uppercase transition-colors hover:text-white"
          >Cookies</a
        >
      </div>
    </div>
  </div>
</footer>
