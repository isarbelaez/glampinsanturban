---
import { asset } from '../utils/assets';

interface Props {
  className?: string;
  size?: string;
  asLink?: boolean;
}

const { className = '', size = 'text-xl', asLink = true } = Astro.props;
const logoSrc = asset('/images/logo.png');
---

{
  asLink ? (
    <a href={import.meta.env.BASE_URL} class:list={['group block shrink-0', className]}>
      <div class="flex items-center gap-2.5 transition-transform group-hover:scale-[1.02]">
        <div class="flex h-10 w-10 items-center justify-center overflow-hidden rounded-full shadow-lg">
          <img src={logoSrc} alt="Logo" class="h-full w-full object-cover" />
        </div>
        <div class="flex flex-col -space-y-1">
          <span class="font-sans text-xl font-bold tracking-tight text-white uppercase">
            SANTURBAN
          </span>
          <span class="text-primary font-sans text-[9px] font-bold tracking-[0.3em] uppercase">
            Glamping
          </span>
        </div>
      </div>
    </a>
  ) : (
    <div class:list={['flex items-center gap-2.5', className]}>
      <div class="flex h-12 w-12 items-center justify-center overflow-hidden rounded-full shadow-lg">
        <img src={logoSrc} alt="Logo" class="h-full w-full object-cover" />
      </div>
      <div class="flex flex-col -space-y-1">
        <span class="font-sans text-2xl font-bold tracking-tight text-white uppercase">
          SANTURBAN
        </span>
        <span class="text-primary font-sans text-[11px] font-bold tracking-[0.3em] uppercase">
          Glamping
        </span>
      </div>
    </div>
  )
}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@400;700&display=swap');

  .font-sans {
    font-family: 'Outfit', sans-serif;
  }
</style>
