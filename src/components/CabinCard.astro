---
import { Button } from '@/components/ui/button';
import pkg from 'lucide-react';
const { User, Bed, Maximize } = pkg;

interface Props {
  image: string;
  name: string;
  price: string;
  capacity: string;
  beds: string;
  size: string;
}

const { image, name, price, capacity, beds, size } = Astro.props;
---

<div
  class="group bg-card hover:border-primary/30 relative overflow-hidden rounded-2xl border border-white/5 transition-all duration-500"
>
  <div class="relative h-72 overflow-hidden">
    <img
      src={image}
      alt={name}
      class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-110"
    />
    <div
      class="absolute inset-0 bg-linear-to-t from-black/80 via-transparent to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100"
    >
    </div>
  </div>

  <div class="p-6">
    <div class="mb-4 flex items-start justify-between">
      <h3 class="font-serif text-2xl font-bold text-white">{name}</h3>
      <div class="text-right">
        <span class="text-primary block text-lg font-bold">{price}</span>
        <span class="text-[10px] tracking-widest text-white/40 uppercase">por noche</span>
      </div>
    </div>

    <div class="mb-8 flex gap-6 border-y border-white/5 py-4">
      <div class="flex items-center gap-2 text-xs text-white/60">
        <User size={14} className="text-primary/70" />
        <span>{capacity}</span>
      </div>
      <div class="flex items-center gap-2 text-xs text-white/60">
        <Bed size={14} className="text-primary/70" />
        <span>{beds}</span>
      </div>
      <div class="flex items-center gap-2 text-xs text-white/60">
        <Maximize size={14} className="text-primary/70" />
        <span>{size}</span>
      </div>
    </div>

    <Button
      className="hover:bg-primary hover:border-primary h-12 w-full rounded-lg border border-white/10 bg-white/5 font-bold tracking-wider text-white uppercase transition-all"
    >
      <a href="#" class="text-primary text-lg font-bold">Reservar Ahora</a>
    </Button>
  </div>
</div>
