---
import { Button } from "@/components/ui/button";
import pkg from "lucide-react";
const { User, Bed, Maximize } = pkg;

interface Props {
  image: string;
  name: string;
  price: string;
  capacity: string;
  beds: string;
  size: string;
}

const { image, name, price, capacity, beds, size } = Astro.props;
---

<div class="group relative bg-card rounded-2xl overflow-hidden border border-white/5 transition-all duration-500 hover:border-primary/30">
  <div class="relative h-72 overflow-hidden">
    <img
      src={image}
      alt={name}
      class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
  </div>

  <div class="p-6">
    <div class="flex justify-between items-start mb-4">
      <h3 class="text-white font-serif text-2xl font-bold">{name}</h3>
      <div class="text-right">
        <span class="block text-primary font-bold text-lg">{price}</span>
        <span class="text-[10px] text-white/40 uppercase tracking-widest">por noche</span>
      </div>
    </div>

    <div class="flex gap-6 mb-8 border-y border-white/5 py-4">
      <div class="flex items-center gap-2 text-white/60 text-xs">
        <User size={14} className="text-primary/70" />
        <span>{capacity}</span>
      </div>
      <div class="flex items-center gap-2 text-white/60 text-xs">
        <Bed size={14} className="text-primary/70" />
        <span>{beds}</span>
      </div>
      <div class="flex items-center gap-2 text-white/60 text-xs">
        <Maximize size={14} className="text-primary/70" />
        <span>{size}</span>
      </div>
    </div>

    <Button className="w-full bg-white/5 hover:bg-primary text-white border border-white/10 hover:border-primary rounded-lg h-12 font-bold uppercase tracking-wider transition-all">
      Reservar Ahora
    </Button>
  </div>
</div>
