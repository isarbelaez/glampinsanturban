---
import pkg from 'lucide-react';
const {
  Wifi,
  WavesHorizontal: Jacuzzi,
  Coffee,
  Flame,
  Wine,
  Utensils,
  UtensilsCrossed,
  Sparkles,
  Droplets,
  Gift,
  BedDouble,
  Bed,
  Bath,
  Tv,
  Thermometer,
} = pkg;

interface Props {
  slug: string;
  image: string;
  title: string;
  price: string;
  description: string;
  features: string[];
}

const { slug, image, title, price, description, features } = Astro.props;

const iconMap: Record<string, any> = {
  wifi: Wifi,
  jacuzzi: Jacuzzi,
  desayuno: Coffee,
  fogata: Flame,
  vino: Wine,
  almuerzo: Utensils,
  cena: UtensilsCrossed,
  decoración: Sparkles,
  decoracion: Sparkles,
  laguna: Droplets,
  chocolates: Gift,
  masmelos: Flame,
  'cama doble': BedDouble,
  camas: Bed,
  'baño privado': Bath,
  TV: Tv,
  calefactor: Thermometer,
};
---

<div
  class="group bg-card hover:shadow-primary/10 overflow-hidden rounded-2xl border border-white/5 transition-all duration-500 hover:-translate-y-2 hover:shadow-2xl"
>
  <div class="relative h-64 overflow-hidden">
    <img
      src={image}
      alt={title}
      class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-110"
    />
    <div
      class="bg-primary absolute top-4 right-4 rounded-full px-3 py-1 text-xs font-bold tracking-wider text-white uppercase"
    >
      {price} / noche
    </div>
  </div>

  <div class="p-6">
    <h3 class="mb-2 font-serif text-2xl font-bold text-white">{title}</h3>
    <p class="mb-6 text-sm leading-relaxed text-white/60">
      {description}
    </p>

    <div class="mb-8 flex gap-4">
      {
        (features || []).map((feature) => {
          const Icon = iconMap[feature];
          return (
            <div class="text-primary/80" title={feature}>
              {Icon && <Icon size={20} />}
            </div>
          );
        })
      }
    </div>

    <a
      href={`${import.meta.env.BASE_URL}planes/${slug}/`}
      class="bg-primary hover:bg-primary/90 flex h-12 w-full items-center justify-center rounded-lg font-bold tracking-wider text-white uppercase transition-all active:scale-95"
    >
      Ver Detalles
    </a>
  </div>
</div>
