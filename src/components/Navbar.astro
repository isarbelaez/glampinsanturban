---
import Logo from './Logo.astro';
import pkg from 'lucide-react';
const { Calendar } = pkg;

const navLinks = [
  { name: 'Inicio', href: import.meta.env.BASE_URL },
  { name: 'Experiencias', href: `${import.meta.env.BASE_URL}experiencias` },
  { name: 'Cabañas', href: `${import.meta.env.BASE_URL}#cabanas` },
  { name: 'Planes', href: `${import.meta.env.BASE_URL}#planes` },
  { name: 'Ubicación', href: `${import.meta.env.BASE_URL}#como-llegar` },
  { name: 'Nosotros', href: `${import.meta.env.BASE_URL}#servicios` },
];
---

<header class="fixed top-0 right-0 left-0 z-50 transition-all duration-500" id="main-header">
  <div class="container mx-auto px-4 md:px-6">
    <div class="flex h-24 items-center justify-between">
      <!-- Logo -->
      <Logo />

      <!-- Navigation (Centered) -->
      <nav class="absolute left-1/2 hidden -translate-x-1/2 items-center gap-6 lg:flex xl:gap-8">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class="hover:text-primary text-xs font-light tracking-[0.15em] text-white/80 uppercase transition-colors"
            >
              {link.name}
            </a>
          ))
        }
      </nav>

      <!-- CTA (Right) -->
      <div class="flex items-center gap-2 md:gap-4">
        <a
          href={`${import.meta.env.BASE_URL}reservar`}
          class="bg-primary hover:bg-primary/90 shadow-primary/20 flex items-center gap-2 rounded-full px-4 py-2.5 text-xs font-bold tracking-widest text-white uppercase shadow-lg transition-all hover:scale-105 active:scale-95 md:px-6"
        >
          <Calendar size={14} />
          <span class="hidden sm:inline">Reservar ahora</span>
        </a>
        <!-- Mobile Menu Toggle -->
        <button id="mobile-menu-toggle" class="group p-2 text-white lg:hidden">
          <div class="relative flex h-5 w-6 flex-col justify-between">
            <span
              class="h-0.5 w-full origin-left bg-current transition-all duration-300 group-[.is-active]:translate-x-1 group-[.is-active]:rotate-45"
            ></span>
            <span
              class="h-0.5 w-full bg-current transition-all duration-300 group-[.is-active]:opacity-0"
            ></span>
            <span
              class="h-0.5 w-full origin-left bg-current transition-all duration-300 group-[.is-active]:translate-x-1 group-[.is-active]:-rotate-45"
            ></span>
          </div>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu Overlay -->
  <div
    id="mobile-menu"
    class="bg-background/95 fixed inset-0 z-40 translate-x-full backdrop-blur-2xl transition-transform duration-500 ease-in-out lg:hidden"
  >
    <div class="flex h-full flex-col px-8 pt-32">
      <nav class="flex flex-col gap-6">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class="mobile-nav-link hover:text-primary font-serif text-2xl font-bold tracking-widest text-white uppercase transition-colors"
            >
              {link.name}
            </a>
          ))
        }
      </nav>

      <div class="mt-auto pb-12">
        <a
          href={`${import.meta.env.BASE_URL}reservar`}
          class="mobile-nav-link bg-primary flex w-full items-center justify-center gap-3 rounded-full py-4 text-sm font-bold tracking-widest text-white uppercase"
        >
          <Calendar size={18} />
          <span>Reservar ahora</span>
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById('main-header');
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const links = document.querySelectorAll('.mobile-nav-link');

  // Sticky Header
  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      header?.classList.add('bg-background/90', 'backdrop-blur-xl', 'h-20', 'shadow-2xl');
      header?.classList.remove('h-24');
    } else {
      header?.classList.remove('bg-background/90', 'backdrop-blur-xl', 'h-20', 'shadow-2xl');
      header?.classList.add('h-24');
    }
  });

  // Toggle Menu
  toggle?.addEventListener('click', () => {
    const isActive = toggle.classList.toggle('is-active');
    menu?.classList.toggle('translate-x-full', !isActive);
    document.body.style.overflow = isActive ? 'hidden' : '';
  });

  // Close menu on link click
  links.forEach((link) => {
    link.addEventListener('click', () => {
      toggle?.classList.remove('is-active');
      menu?.classList.add('translate-x-full');
      document.body.style.overflow = '';
    });
  });
</script>
