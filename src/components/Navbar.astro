---
import Logo from './Logo.astro';
import pkg from 'lucide-react';
const { Calendar } = pkg;

const navLinks = [
  { name: 'Inicio', href: '/' },
  { name: 'Experiencias', href: '#experiencias' },
  { name: 'Cabañas', href: '#cabanas' },
  { name: 'Galería', href: '#galeria' },
  { name: 'Blog', href: '#blog' },
  { name: 'Nosotros', href: '#nosotros' },
  { name: 'Contacto', href: '#contacto' },
];
---

<header class="fixed top-0 right-0 left-0 z-50 transition-all duration-500" id="main-header">
  <div class="container mx-auto px-4 md:px-6">
    <div class="flex h-24 items-center justify-between">
      <!-- Logo -->
      <Logo />

      <!-- Navigation (Centered) -->
      <nav class="absolute left-1/2 hidden -translate-x-1/2 items-center gap-6 lg:flex xl:gap-8">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class="hover:text-primary text-xs font-light tracking-[0.15em] text-white/80 uppercase transition-colors"
            >
              {link.name}
            </a>
          ))
        }
      </nav>

      <!-- CTA (Right) -->
      <div class="flex items-center gap-2 md:gap-4">
        <a
          href="#reservar"
          class="bg-primary hover:bg-primary/90 shadow-primary/20 flex items-center gap-2 rounded-full px-4 py-2.5 text-xs font-bold tracking-widest text-white uppercase shadow-lg transition-all hover:scale-105 active:scale-95 md:px-6"
        >
          <Calendar size={14} />
          <span class="hidden sm:inline">Reservar ahora</span>
        </a>
        <!-- Mobile Menu Toggle -->
        <button class="p-2 text-white lg:hidden">
          <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16m-7 6h7"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById('main-header');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      header?.classList.add('bg-background/90', 'backdrop-blur-xl', 'h-20', 'shadow-2xl');
      header?.classList.remove('h-24');
    } else {
      header?.classList.remove('bg-background/90', 'backdrop-blur-xl', 'h-20', 'shadow-2xl');
      header?.classList.add('h-24');
    }
  });
</script>
