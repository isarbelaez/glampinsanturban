---
import { asset } from '../utils/assets';

const testimonials = [
  {
    name: 'Belkis Amarís',
    text: 'Este lugar reúne todo lo que está bien hecho en la vida; paisaje, clima, comida deliciosa, atención, comodidad, limpieza. Un paraíso en la tierra, lo súper recomiendo, no se arrepentirán.',
    photo: asset('/images/alkimis.webp'),
  },
  {
    name: 'Natali Tarazona.',
    text: 'Lugar súper recomendado!! Si estás en busca de tranquilidad y conectarte con la Naturaleza',
    photo: asset('/images/rojo.webp'),
  },
  {
    name: 'German Dario.',
    text: 'Gracias por permitirnos vivir una experiencia maravillosa,  volveremos pronto , super recomendados',
    photo: asset('/images/verde.webp'),
  },
];
---

<section id="testimonios" class="bg-background overflow-hidden py-24">
  <div class="container mx-auto px-4 md:px-6">
    <div class="flex flex-col items-start gap-16 lg:flex-row">
      <!-- Left Side: Vertical Testimonials -->
      <div class="w-full space-y-12 lg:w-2/3">
        <div class="mb-12">
          <p class="text-primary mb-4 text-[10px] font-bold tracking-[0.4em] uppercase">
            Voces de nuestros huéspedes
          </p>
          <h2
            class="text-foreground font-serif text-3xl font-bold tracking-[0.15em] uppercase md:text-5xl"
          >
            Testimonios
          </h2>
        </div>

        <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
          {
            testimonials.map((t) => (
              <div class="group bg-card flex flex-col items-center rounded-3xl border border-black/5 p-8 text-center shadow-sm transition-all duration-500">
                <div class="border-primary/30 group-hover:border-primary mb-6 h-20 w-20 overflow-hidden rounded-full border-2 transition-colors">
                  <img
                    src={t.photo}
                    alt={t.name}
                    class="h-full w-full object-cover"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <p class="text-foreground/70 mb-6 text-sm leading-relaxed italic">"{t.text}"</p>
                <span class="text-foreground text-[10px] font-bold tracking-widest uppercase">
                  {t.name}
                </span>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Right Side: Google CTA -->
      <div class="h-full w-full lg:w-1/3">
        <div
          class="group bg-card relative flex h-full min-h-[400px] flex-col items-center justify-center overflow-hidden rounded-3xl border border-black/5 p-10 text-center"
        >
          <!-- Decorative Background Icon -->
          <div
            class="pointer-events-none absolute -right-10 -bottom-10 rotate-12 opacity-[0.03] transition-transform duration-1000 group-hover:rotate-0"
          >
            <svg class="h-64 w-64" viewBox="0 0 24 24" fill="currentColor">
              <path
                class="text-black/5"
                d="M12.48 10.92v3.28h7.84c-.24 1.84-.853 3.187-1.787 4.133-1.147 1.147-2.933 2.4-6.053 2.4-4.827 0-8.6-3.893-8.6-8.72s3.773-8.72 8.6-8.72c2.6 0 4.507 1.027 5.907 2.347l2.307-2.307C18.747 1.44 16.133 0 12.48 0 5.867 0 .307 5.387.307 12s5.56 12 12.173 12c3.573 0 6.267-1.173 8.373-3.36 2.16-2.16 2.84-5.213 2.84-7.667 0-.76-.053-1.467-.173-2.053H12.48z"
              ></path>
            </svg>
          </div>

          <div
            class="mb-8 flex h-20 w-20 items-center justify-center rounded-2xl bg-white shadow-2xl"
          >
            <svg class="h-10 w-10" viewBox="0 0 24 24">
              <path
                fill="#4285F4"
                d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
              ></path>
              <path
                fill="#34A853"
                d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
              ></path>
              <path
                fill="#FBBC05"
                d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z"
              ></path>
              <path
                fill="#EA4335"
                d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
              ></path>
            </svg>
          </div>

          <h3 class="text-foreground mb-4 text-xl font-bold">¿Ya nos visitaste?</h3>
          <p class="text-foreground/50 mb-10 text-sm leading-relaxed">
            Tu opinión es muy importante para nosotros y para futuros aventureros.
          </p>

          <a
            href="https://search.google.com/local/writereview?placeid=ChIJnS5SxYxlaI4R2KL004fj8To&utm_source=chatgpt.com"
            target="_blank"
            class="hover:bg-primary w-full rounded-xl bg-white py-4 text-xs font-bold tracking-widest text-black uppercase transition-all duration-300 hover:text-white"
          >
            Escribir mi experiencia
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
