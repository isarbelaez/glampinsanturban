---
import PlanCard from './PlanCard.astro';
import { asset } from '../utils/assets';

import { plansData } from '../data/plans';

interface Props {
  excludeSlug?: string;
}

const { excludeSlug } = Astro.props;

const originalPlans = excludeSlug
  ? (plansData || []).filter((p) => p.slug !== excludeSlug)
  : plansData || [];

// Mark clones to allow hiding them in specific categories
const plans = [
  ...originalPlans.map((p) => ({ ...p, isClone: true })),
  ...originalPlans.map((p) => ({ ...p, isClone: false })),
  ...originalPlans.map((p) => ({ ...p, isClone: true })),
];
const originalCount = originalPlans.length;
---

<section id="planes" class="bg-background relative overflow-hidden pt-40 pb-24">
  <!-- Subtle patterns -->
  <div class="pointer-events-none absolute inset-0 opacity-5">
    <div class="bg-primary absolute top-0 right-0 h-96 w-96 rounded-full blur-[120px]"></div>
    <div class="bg-primary absolute bottom-0 left-0 h-96 w-96 rounded-full blur-[120px]"></div>
  </div>

  <div class="relative z-10 container mx-auto px-4 md:px-6">
    <div class="mb-12 flex flex-col justify-between gap-8 md:flex-row md:items-end">
      <div class="text-left">
        <p class="text-primary mb-3 text-[10px] font-bold tracking-[0.4em] uppercase md:text-xs">
          {excludeSlug ? 'Explora otras opciones' : '¿Qué experiencia te gustaría vivir?'}
        </p>
        <h2
          class="text-foreground font-serif text-3xl font-bold tracking-[0.15em] uppercase md:text-4xl"
        >
          {excludeSlug ? 'Otros Planes' : 'Nuestros Planes'}
        </h2>
      </div>

      <!-- Filter Buttons -->
      <div class="flex gap-3">
        <button
          id="filter-glamping"
          class="filter-btn is-active border-primary/30 bg-primary/10 hover:border-primary text-foreground cursor-pointer rounded-full border px-6 py-2 text-xs font-bold tracking-widest uppercase transition-all"
        >
          Glamping
        </button>
        <button
          id="filter-hostal"
          class="filter-btn hover:border-primary bg-card text-foreground cursor-pointer rounded-full border border-black/5 px-6 py-2 text-xs font-bold tracking-widest uppercase transition-all"
        >
          Hostal
        </button>
      </div>
    </div>

    <!-- Carousel Container -->
    <div class="group relative">
      <!-- Navigation Buttons -->
      <button
        id="prev-plan"
        class="hover:bg-primary hover:border-primary bg-card text-foreground absolute top-[40%] -left-4 z-20 flex h-12 w-12 -translate-y-1/2 items-center justify-center rounded-full border border-black/10 backdrop-blur-md transition-all active:scale-90 md:-left-8"
        aria-label="Anterior"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"><path d="m15 18-6-6 6-6"></path></svg
        >
      </button>

      <button
        id="next-plan"
        class="hover:bg-primary hover:border-primary bg-card text-foreground absolute top-[40%] -right-4 z-20 flex h-12 w-12 -translate-y-1/2 items-center justify-center rounded-full border border-black/10 backdrop-blur-md transition-all active:scale-90 md:-right-8"
        aria-label="Siguiente"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"><path d="m9 18 6-6-6-6"></path></svg
        >
      </button>

      <div
        id="plans-carousel"
        class="scrollbar-hide flex cursor-grab snap-x snap-mandatory gap-6 overflow-x-auto pb-12 select-none active:cursor-grabbing"
      >
        {
          plans.map((plan, index) => (
            <div
              class="plan-item pointer-events-none min-w-[85vw] snap-center transition-all duration-500 md:min-w-[420px]"
              data-category={plan.category}
              data-clone={plan.isClone ? 'true' : 'false'}
            >
              <div class="pointer-events-auto">
                <PlanCard {...plan} />
              </div>
            </div>
          ))
        }
      </div>

      <!-- Scroll Progress Bar -->
      <div class="mt-4 h-0.5 w-full overflow-hidden rounded-full bg-white/10">
        <div id="carousel-progress" class="bg-primary h-full w-0 transition-all duration-300"></div>
      </div>
    </div>

    <!-- Menu Button -->
    <div class="mt-20 flex justify-center">
      <button
        id="toggle-menu-btn"
        class="group hover:border-primary/50 bg-card relative inline-flex cursor-pointer items-center justify-center overflow-hidden rounded-full border border-black/10 px-10 py-4 font-bold transition-all"
      >
        <span
          class="bg-primary absolute inset-0 h-full w-0 transition-all duration-300 ease-out group-hover:w-full"
        ></span>
        <span
          class="text-foreground relative text-xs tracking-widest uppercase group-hover:text-white"
          >Mirar nuestro menú</span
        >
      </button>
    </div>

    <!-- Hidden Menu Section -->
    <div
      id="menu-dropdown"
      class="grid overflow-hidden transition-all duration-500 ease-in-out"
      style="grid-template-rows: 0fr;"
    >
      <div class="min-h-0">
        <div class="pt-12 pb-4">
          <div class="grid grid-cols-2 gap-4 md:grid-cols-5">
            {
              [
                {
                  name: 'Menu 1',
                  price: '$20.000',
                  desc: 'CaldoCaldo típico de huevo o de costilla, queso, arepa y bebida caliente ',
                },
                {
                  name: 'Menu 2',
                  price: '$20.000',
                  desc: 'Papas locas de montaña.',
                },
                {
                  name: 'Menu 3',
                  price: '$15.000',
                  desc: 'Arepa rellena (pollo, queso, tomaté y cebolla), bebida caliente',
                },
                {
                  name: 'Menu 4',
                  price: '$20.000',
                  desc: 'Sandwich cubano y papas a la francesa (carne o pollo)',
                },
                {
                  name: 'Menu 5',
                  price: '$20.000',
                  desc: 'Carnes con papas a la francesa o casquitos.',
                },
              ].map((item) => (
                <div class="group bg-card flex h-full flex-col justify-between rounded-xl border border-black/5 p-6 transition-colors">
                  <div>
                    <h4 class="text-foreground mb-3 font-serif text-lg leading-tight font-bold">
                      {item.name}
                    </h4>
                    <p class="text-foreground/60 mb-6 text-sm leading-relaxed">{item.desc}</p>
                  </div>
                  <div class="bg-primary/20 text-primary border-primary/30 group-hover:bg-primary inline-block w-fit rounded-full border px-4 py-1.5 text-xs font-bold tracking-wider transition-colors group-hover:text-white">
                    {item.price}
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  #plans-carousel {
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
  }

  #plans-carousel.dragging {
    scroll-behavior: auto;
    scroll-snap-type: none;
  }
</style>

<script define:vars={{ originalCount }}>
  const carousel = document.getElementById('plans-carousel');
  const progress = document.getElementById('carousel-progress');
  const filterBtns = document.querySelectorAll('.filter-btn');

  if (carousel && progress) {
    let items = Array.from(carousel.querySelectorAll('.plan-item'));
    let setWidth = 0;
    let isDown = false;
    let startX;
    let scrollLeft;
    let autoScrollActive = true;
    let currentCategory = 'glamping';

    const updateDimensions = () => {
      const visibleItems = items.filter(
        (item) => !item.classList.contains('hidden') && !item.classList.contains('opacity-0')
      );
      if (visibleItems.length === 0) return;

      const firstItem = visibleItems[0];
      const secondItem = visibleItems[1];
      const itemWidth = firstItem.clientWidth;
      const gap = secondItem
        ? secondItem.offsetLeft - (firstItem.offsetLeft + firstItem.clientWidth)
        : 24;

      // The originalCount in the infinite loop is total / 3
      const currentVisibleOriginalCount =
        category === 'hostal' ? visibleItems.length : visibleItems.length / 3;
      setWidth = (itemWidth + gap) * currentVisibleOriginalCount;
    };

    const filterPlans = (category) => {
      currentCategory = category;

      // Update UI buttons
      filterBtns.forEach((btn) => {
        if (btn.id === `filter-${category}`) {
          btn.classList.add('is-active', 'bg-primary/10', 'border-primary/30');
          btn.classList.remove('bg-card', 'border-black/5');
        } else {
          btn.classList.remove('is-active', 'bg-primary/10', 'border-primary/30');
          btn.classList.add('bg-card', 'border-black/5');
        }
      });

      // Show/Hide items with transition
      items.forEach((item) => {
        const isMatch = item.dataset.category === category;
        const isClone = item.dataset.clone === 'true';

        // Hide clones if hostal is selected to show only 2 items
        if (isMatch && (category !== 'hostal' || !isClone)) {
          item.classList.remove('hidden');
          setTimeout(() => item.classList.remove('opacity-0', 'scale-95'), 10);
        } else {
          item.classList.add('opacity-0', 'scale-95');
          setTimeout(() => item.classList.add('hidden'), 500);
        }
      });

      // Update carousel centering for Hostal
      if (category === 'hostal') {
        carousel.classList.add('md:justify-center');
        document.getElementById('prev-plan')?.classList.add('hidden');
        document.getElementById('next-plan')?.classList.add('hidden');
      } else {
        carousel.classList.remove('md:justify-center');
        document.getElementById('prev-plan')?.classList.remove('hidden');
        document.getElementById('next-plan')?.classList.remove('hidden');
      }

      // Recalculate and reset after transition
      setTimeout(() => {
        updateDimensions();
        if (category === 'hostal') {
          carousel.scrollLeft = 0;
        } else {
          carousel.scrollLeft = setWidth;
        }
      }, 510);
    };

    // Filter Listeners
    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const category = btn.id.replace('filter-', '');
        if (category === currentCategory) return;
        filterPlans(category);
      });
    });

    const init = () => {
      // Start with glamping visible, hostal hidden
      items.forEach((item) => {
        if (item.dataset.category !== 'glamping') {
          item.classList.add('hidden', 'opacity-0', 'scale-95');
        }
      });

      updateDimensions();
      carousel.scrollLeft = setWidth;
    };

    window.addEventListener('load', init);
    setTimeout(init, 500);

    // Infinite Logic
    carousel.addEventListener('scroll', () => {
      if (setWidth === 0) return;

      const scrollPos = carousel.scrollLeft;
      const normalizedScroll = scrollPos % setWidth;
      const scrollPercentage = (normalizedScroll / setWidth) * 100;
      progress.style.width = `${scrollPercentage}%`;

      if (!isDown && currentCategory !== 'hostal') {
        if (scrollPos < setWidth * 0.5) {
          carousel.scrollTo({ left: scrollPos + setWidth, behavior: 'instant' });
        } else if (scrollPos > setWidth * 2.2) {
          carousel.scrollTo({ left: scrollPos - setWidth, behavior: 'instant' });
        }
      }
    });

    let lastTime = 0;
    const animate = () => {
      if (autoScrollActive && !isDown && setWidth > 0 && currentCategory !== 'hostal') {
        carousel.scrollLeft += 0.5;
      }
      requestAnimationFrame(animate);
    };
    requestAnimationFrame(animate);

    const stopAuto = () => (autoScrollActive = false);
    const startAuto = () => (autoScrollActive = true);

    carousel.addEventListener('mousedown', (e) => {
      isDown = true;
      stopAuto();
      carousel.classList.add('dragging');
      startX = e.pageX - carousel.offsetLeft;
      scrollLeft = carousel.scrollLeft;
    });

    window.addEventListener('mouseup', () => {
      if (!isDown) return;
      isDown = false;
      carousel.classList.remove('dragging');

      if (currentCategory !== 'hostal') {
        const scrollPos = carousel.scrollLeft;
        if (scrollPos < setWidth * 0.5) {
          carousel.scrollTo({ left: scrollPos + setWidth, behavior: 'instant' });
        } else if (scrollPos > setWidth * 2.2) {
          carousel.scrollTo({ left: scrollPos - setWidth, behavior: 'instant' });
        }
      }

      setTimeout(startAuto, 2000);
    });

    carousel.addEventListener('mousemove', (e) => {
      if (!isDown) return;
      e.preventDefault();
      const x = e.pageX - carousel.offsetLeft;
      const walk = (x - startX) * 2;
      carousel.scrollLeft = scrollLeft - walk;
    });

    carousel.addEventListener('mouseenter', stopAuto);
    carousel.addEventListener('mouseleave', () => {
      if (!isDown) startAuto();
    });
    carousel.addEventListener('touchstart', stopAuto);
    carousel.addEventListener('touchend', startAuto);

    document.getElementById('prev-plan')?.addEventListener('click', () => {
      stopAuto();
      const visibleItems = items.filter((i) => !i.classList.contains('hidden'));
      const step = visibleItems[0]?.clientWidth + 24 || 300;
      carousel.scrollBy({ left: -step, behavior: 'smooth' });
      setTimeout(startAuto, 3000);
    });

    document.getElementById('next-plan')?.addEventListener('click', () => {
      stopAuto();
      const visibleItems = items.filter((i) => !i.classList.contains('hidden'));
      const step = visibleItems[0]?.clientWidth + 24 || 300;
      carousel.scrollBy({ left: step, behavior: 'smooth' });
      setTimeout(startAuto, 3000);
    });

    window.addEventListener('resize', updateDimensions);
  }

  // Menu Toggle Logic
  const menuBtn = document.getElementById('toggle-menu-btn');
  const menuDropdown = document.getElementById('menu-dropdown');

  if (menuBtn && menuDropdown) {
    menuBtn.addEventListener('click', () => {
      const isExpanded = menuDropdown.style.gridTemplateRows === '1fr';
      menuDropdown.style.gridTemplateRows = isExpanded ? '0fr' : '1fr';
      const span = menuBtn.querySelector('span.relative');
      if (span) span.textContent = isExpanded ? 'Mirar nuestro menú' : 'Ocultar menú';
    });
  }
</script>
