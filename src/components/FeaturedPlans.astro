---
import PlanCard from './PlanCard.astro';

const originalPlans = [
  {
    title: 'Santurban',
    price: '$290.000',
    image: '/public/images/cabaña.jpeg',
    description: 'Una experiencia inolvidable, cabaña con calefaccion y desayuno Incluido.',
    features: ['wifi', 'jacuzzi', 'desayuno'],
  },
  {
    title: 'Plan Romantico',
    price: '$390.000',
    image: '/public/images/exterior.jpeg',
    description:
      'Disfruta de una agradable decoracion, desatuno, almuerzo y fogata con chocolate y masmelos.',
    features: ['wifi', 'desayuno', 'fogata', 'almuerzo', 'decoracion'],
  },
  {
    title: 'Plan Laguna Encantada',
    price: '$560.000',
    image: '/public/images/paisaje.jpeg',
    description: 'Una experincia frente a la laguna con una vista hermosa.',
    features: ['wifi', 'Laguna', 'desayuno'],
  },
  {
    title: 'Plan Paramos',
    price: '$230.000',
    image: '/public/images/cama.jpeg',
    description: 'Disfruta un dia de descanso en nuestra cabaña con una vista hermosa.',
    features: ['wifi', 'desayuno', 'fogata'],
  },
  {
    title: 'Plan Noche de Pareja',
    price: '$490.000',
    image: '/public/images/espejo.jpeg',
    description: 'Disfruta una velada romantica con la persona que amas',
    features: ['wifi', 'desayuno', 'vino', 'Fogata', 'Almuerzo'],
  },
];

// Triple the plans for infinite effect
const plans = [...originalPlans, ...originalPlans, ...originalPlans];
---

<section id="planes" class="relative overflow-hidden bg-[#071412] py-24">
  <!-- Subtle patterns -->
  <div class="pointer-events-none absolute inset-0 opacity-5">
    <div class="bg-primary absolute top-0 right-0 h-96 w-96 rounded-full blur-[120px]"></div>
    <div class="bg-primary absolute bottom-0 left-0 h-96 w-96 rounded-full blur-[120px]"></div>
  </div>

  <div class="relative z-10 container mx-auto px-4 md:px-6">
    <div class="mb-16 flex flex-col justify-between gap-6 md:flex-row md:items-end">
      <div class="text-left">
        <p class="text-primary mb-3 text-[10px] font-bold tracking-[0.4em] uppercase md:text-xs">
          ¿Qué experiencia te gustaría vivir?
        </p>
        <h2
          class="font-serif text-3xl font-bold tracking-[0.15em] text-white uppercase md:text-4xl"
        >
          Nuestros Planes
        </h2>
      </div>
    </div>

    <!-- Carousel Container -->
    <div class="group relative">
      <!-- Navigation Buttons -->
      <button
        id="prev-plan"
        class="hover:bg-primary hover:border-primary absolute top-1/2 -left-4 z-20 flex h-12 w-12 -translate-y-1/2 items-center justify-center rounded-full border border-white/20 bg-white/10 text-white backdrop-blur-md transition-all active:scale-90 md:-left-8"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"><path d="m15 18-6-6 6-6"></path></svg
        >
      </button>

      <button
        id="next-plan"
        class="hover:bg-primary hover:border-primary absolute top-1/2 -right-4 z-20 flex h-12 w-12 -translate-y-1/2 items-center justify-center rounded-full border border-white/20 bg-white/10 text-white backdrop-blur-md transition-all active:scale-90 md:-right-8"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"><path d="m9 18 6-6-6-6"></path></svg
        >
      </button>

      <div
        id="plans-carousel"
        class="scrollbar-hide flex snap-x snap-mandatory gap-6 overflow-x-auto pb-12 select-none"
      >
        {
          plans.map((plan, index) => (
            <div class="plan-item pointer-events-none min-w-[85vw] snap-center md:min-w-[400px]">
              <div class="pointer-events-auto">
                <PlanCard {...plan} />
              </div>
            </div>
          ))
        }
      </div>

      <!-- Scroll Progress Bar -->
      <div class="mt-4 h-0.5 w-full overflow-hidden rounded-full bg-white/10">
        <div id="carousel-progress" class="bg-primary h-full w-0 transition-all duration-300"></div>
      </div>
    </div>

    <!-- Menu Button -->
    <div class="mt-20 flex justify-center">
      <a
        href="#menu"
        class="group hover:border-primary/50 relative inline-flex items-center justify-center overflow-hidden rounded-full border border-white/20 bg-transparent px-10 py-4 font-bold transition-all"
      >
        <span
          class="bg-primary absolute inset-0 h-full w-0 transition-all duration-300 ease-out group-hover:w-full"
        ></span>
        <span class="relative text-xs tracking-widest text-white uppercase group-hover:text-white"
          >Mirar nuestro menú</span
        >
      </a>
    </div>
  </div>
</section>

<style>
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  #plans-carousel {
    scroll-behavior: smooth;
  }
</style>

<script>
  const carousel = document.getElementById('plans-carousel');
  const progress = document.getElementById('carousel-progress');
  const originalCount = 5; // Should match originalPlans.length

  if (carousel && progress) {
    const items = carousel.querySelectorAll('.plan-item');

    // Function to calculate dimensions
    const getDimensions = () => {
      const firstItem = items[0];
      const secondItem = items[1];
      const itemWidth = firstItem.clientWidth;
      const gap = secondItem
        ? secondItem.offsetLeft - (firstItem.offsetLeft + firstItem.clientWidth)
        : 24;
      return { itemWidth, gap, totalSetWidth: (itemWidth + gap) * originalCount };
    };

    let { totalSetWidth } = getDimensions();

    // Initial position: start of the middle set
    const initCarousel = () => {
      carousel.scrollLeft = totalSetWidth;
    };

    // Initialize after a small delay to ensure rendering
    setTimeout(initCarousel, 100);

    // Scroll progress handler & Infinite logic
    carousel.addEventListener('scroll', () => {
      const scrollPos = carousel.scrollLeft;

      // Update progress bar based on the middle set
      const normalizedScroll = scrollPos % totalSetWidth;
      const scrollPercentage = (normalizedScroll / totalSetWidth) * 100;
      progress.style.width = `${scrollPercentage}%`;

      // Infinite loop logic
      if (scrollPos < totalSetWidth * 0.5) {
        carousel.scrollBehavior = 'auto';
        carousel.scrollLeft = scrollPos + totalSetWidth;
        carousel.scrollBehavior = 'smooth';
      } else if (scrollPos > totalSetWidth * 2) {
        carousel.scrollBehavior = 'auto';
        carousel.scrollLeft = scrollPos - totalSetWidth;
        carousel.scrollBehavior = 'smooth';
      }
    });

    // Navigation Buttons logic
    const prevBtn = document.getElementById('prev-plan');
    const nextBtn = document.getElementById('next-plan');

    const getScrollStep = () => {
      const firstItem = items[0];
      return firstItem.clientWidth + 24; // width + gap
    };

    prevBtn?.addEventListener('click', () => {
      carousel.scrollBy({ left: -getScrollStep(), behavior: 'smooth' });
    });

    nextBtn?.addEventListener('click', () => {
      carousel.scrollBy({ left: getScrollStep(), behavior: 'smooth' });
    });

    // Handle window resize
    window.addEventListener('resize', () => {
      ({ totalSetWidth } = getDimensions());
    });
  }
</script>
