---
import { MapComponent } from '../shared/MapComponent.tsx';
---

<section id="como-llegar" class="dark relative h-[800px] overflow-hidden bg-[#050f0e] md:h-[600px]">
  {/* MAPA FULL BLEED */}
  <div class="absolute inset-0 z-0">
    <MapComponent client:visible />
  </div>

  {/* CONTENIDO SUPERPUESTO */}
  <div
    class="pointer-events-none absolute inset-0 z-20 flex max-w-2xl flex-col justify-start px-6 pt-20 pb-12 md:justify-center md:px-22 md:pt-0 md:pb-0"
  >
    <span class="text-primary mb-4 text-sm font-medium tracking-widest uppercase drop-shadow-sm">
      Cómo llegar
    </span>

    <h2
      class="font-heading text-foreground text-4xl leading-tight font-semibold drop-shadow-md md:text-5xl"
    >
      A solo 1:30 horas de
      <span class="text-primary">Bucaramanga</span>
    </h2>

    <p class="text-muted-foreground mt-4 max-w-md text-base leading-relaxed drop-shadow-sm">
      Desconéctate en medio de la naturaleza sin ir lejos. Sigue la ruta disfrutando de los hermosos
      paisajes de la región hasta llegar al corazón del páramo de Santurbán.
    </p>

    <div class="pointer-events-auto mt-8 flex gap-3">
      <a
        href="https://www.google.com/maps/dir/?api=1&destination=7.2191149%2C-72.8506305&utm_source=chatgpt.com"
        target="_blank"
        rel="noopener noreferrer"
        class="bg-primary text-primary-foreground hover:shadow-primary/25 inline-flex items-center gap-2 rounded-lg px-5 py-2.5 text-sm font-medium transition-all hover:opacity-90 hover:shadow-lg"
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
          ></path>
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
          ></path>
        </svg>
        Google Maps
      </a>

      <a
        href="https://waze.com/ul/hd3k1n4py3"
        target="_blank"
        rel="noopener noreferrer"
        class="border-border bg-background/50 text-foreground hover:bg-background/80 inline-flex items-center gap-2 rounded-lg border px-5 py-2.5 text-sm font-medium backdrop-blur-sm transition-all"
      >
        Abrir en Waze
      </a>
    </div>
  </div>
</section>
