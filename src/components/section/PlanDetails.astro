---
import type { Plan } from '../../data/plans';
import { Button } from '../ui/button';
import pkg from 'lucide-react';
const {
  Wifi,
  WavesHorizontal: Jacuzzi,
  Coffee,
  Flame,
  Check,
  Wine,
  Utensils,
  UtensilsCrossed,
  Sparkles,
  Droplets,
  Gift,
  BedDouble,
  Bed,
  Bath,
  Tv,
  Thermometer,
} = pkg;

interface Props {
  plan: Plan;
}

const { plan } = Astro.props;

const iconMap: Record<string, any> = {
  wifi: Wifi,
  jacuzzi: Jacuzzi,
  desayuno: Coffee,
  fogata: Flame,
  vino: Wine,
  almuerzo: Utensils,
  cena: UtensilsCrossed,
  decoración: Sparkles,
  decoracion: Sparkles,
  laguna: Droplets,
  chocolates: Gift,
  masmelos: Flame,
  'cama doble': BedDouble,
  camas: Bed,
  'baño privado': Bath,
  TV: Tv,
  calefactor: Thermometer,
};
---

<section class="bg-[#050f0e] pt-32 pb-24">
  <div class="container mx-auto px-4 md:px-6">
    <!-- Title & Horizontal Rectangle Summary -->
    <div class="mb-12">
      <h1 class="mb-8 font-serif text-4xl font-bold text-white md:text-5xl lg:text-6xl">
        {plan.title}
      </h1>

      <div class="inline-block rounded-xl border border-white/10 bg-white/5 p-4 backdrop-blur-sm">
        <div class="flex flex-wrap items-center gap-6">
          {
            (plan.features || []).map((feature) => {
              const Icon = iconMap[feature.toLowerCase()] || iconMap[feature] || Check;
              return (
                <div class="flex items-center gap-2.5">
                  <div class="text-primary">
                    <Icon size={18} />
                  </div>
                  <span class="text-[10px] font-bold tracking-wider text-white/70 uppercase">
                    {feature}
                  </span>
                </div>
              );
            })
          }
        </div>
      </div>
    </div>

    <!-- Gallery & Sticky Sidebar -->
    <div class="mt-12 grid grid-cols-1 items-start gap-12 lg:grid-cols-3">
      <!-- Gallery & Details (Left) -->
      <div class="space-y-12 lg:col-span-2">
        <!-- Main Description -->
        <div class="prose prose-invert max-w-none">
          <h2 class="mb-6 font-serif text-3xl font-bold text-white">Sobre la experiencia</h2>
          <p class="text-lg leading-relaxed text-white/70">
            {plan.details}
          </p>
        </div>

        <!-- Gallery -->
        <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
          {
            plan.category === 'hostal' ? (
              <>
                {/* Hostal Layout: Horizontal Image + Vertical Video */}
                <div class="aspect-video overflow-hidden rounded-xl bg-white/5 md:aspect-auto">
                  <img
                    src={plan.gallery[0]}
                    alt={`${plan.title} foto`}
                    class="h-full w-full object-cover transition-transform duration-700 hover:scale-105"
                  />
                </div>
                {plan.video && (
                  <div class="aspect-[9/16] overflow-hidden rounded-xl bg-white/5">
                    <video
                      src={plan.video}
                      autoplay
                      loop
                      muted
                      playsinline
                      class="h-full w-full object-cover"
                    />
                  </div>
                )}
              </>
            ) : (
              <>
                {/* Glamping Layout: Standard Grid */}
                {(plan.gallery || []).slice(0, 3).map((img, idx) => (
                  <div
                    class={`overflow-hidden rounded-xl bg-white/5 ${idx === 0 ? 'row-span-2 aspect-[3/4] md:aspect-[4/5]' : 'aspect-video'}`}
                  >
                    <img
                      src={img}
                      alt={`${plan.title} foto ${idx + 1}`}
                      class="h-full w-full object-cover transition-transform duration-700 hover:scale-105"
                    />
                  </div>
                ))}
                {plan.video && (
                  <div class="aspect-[9/16] overflow-hidden rounded-xl bg-white/5 md:row-span-2">
                    <video
                      src={plan.video}
                      autoplay
                      loop
                      muted
                      playsinline
                      class="h-full w-full object-cover"
                    />
                  </div>
                )}
              </>
            )
          }
        </div>
      </div>

      <!-- Floating Price Box (Right, takes 1 column) -->
      <div class="sticky top-32 lg:col-span-1">
        <div class="rounded-2xl border border-white/10 bg-[#071412] p-8 shadow-2xl">
          <div class="mb-8">
            <p class="mb-2 text-sm font-medium tracking-wider text-white/60 uppercase">
              Precio por noche
            </p>
            <p class="font-serif text-4xl font-bold text-white">{plan.price}</p>
          </div>

          <ul class="mb-10 space-y-4 border-b border-white/10 pb-8">
            <li
              class="flex items-center gap-3 text-xs font-medium tracking-wide text-white/50 uppercase"
            >
              <Check size={14} class="text-primary/60" /> Reserva segura
            </li>
            <li
              class="flex items-center gap-3 text-xs font-medium tracking-wide text-white/50 uppercase"
            >
              <Check size={14} class="text-primary/60" /> Cancelación flexible
            </li>
            <li
              class="flex items-center gap-3 text-xs font-medium tracking-wide text-white/50 uppercase"
            >
              <Check size={14} class="text-primary/60" /> Atención 24/7
            </li>
          </ul>

          <a
            href={`https://wa.me/${plan.whatsapp || '17869097263'}?text=Hola!%20Quiero%20reservar%20el%20plan%20${encodeURIComponent(plan.title)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="block w-full"
          >
            <Button
              variant="outline"
              className="border-primary text-primary hover:bg-primary/10 h-14 w-full rounded-xl font-bold tracking-wider uppercase transition-all"
            >
              Reservar este plan
            </Button>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
